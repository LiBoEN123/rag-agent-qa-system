    {
      "id": "mcp-firecrawl-approval-001",
      "version": 2,
      "suite": "mcp",
      "category": "firecrawl_approval_gate",
      "mcp_servers": ["firecrawl"],
      "question": "请使用 Firecrawl crawl 从 https://docs.pydantic.dev/ 开始启动一次最多 1 页的 crawl。",
      "expected": {
        "decision": "use_agent",
        "action": "agent",
        "status": "TOOL_ERROR",
        "first_tool": "firecrawl_firecrawl_crawl",
        "tools_contains": ["firecrawl_firecrawl_crawl"],
        "tool_sequence": ["firecrawl_firecrawl_crawl"],
        "tool_status_sequence": ["error"],
        "tool_origin": "mcp",
        "mcp_server": "firecrawl",
        "approval_required": true
