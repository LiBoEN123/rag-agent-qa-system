  "cases": [
    {
      "id": "mcp-github-file-001",
      "version": 2,
      "suite": "mcp",
      "category": "github_repository_read",
      "mcp_servers": ["github"],
      "question": "请使用 GitHub 工具读取 LiBoEN123/rag-agent-qa-system 仓库 main 分支的 README.md，并简要说明该项目是什么。",
      "expected": {
        "decision": "use_agent",
        "action": "agent",
        "status": "OK",
        "first_tool": "github_get_file_contents",
        "tools_contains": ["github_get_file_contents"],
        "tool_origin": "mcp",
        "mcp_server": "github",
        "tool_output_keys": [
          "content",
          "content_is_untrusted",
          "server",
          "tool",
          "truncated"
        ],
        "content_is_untrusted": true,
        "external_output_nonempty": true
      },
      "tags": ["extended", "github", "read_only", "untrusted_content"],
      "notes": "只门禁稳定的工具选择和标准化输出合同，不保存 README 全文。"
    },
