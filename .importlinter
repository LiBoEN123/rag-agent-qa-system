[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:application-layers]
name = Application modules follow one dependency direction
type = layers
layers =
    app.api
    app.services
    app.agent
    app.sources
    app.tools
    app.rag : app.indexing
    app.storage : app.observability
    app.ingestion
    app.llm
    app.contracts | app.config | app.common

[importlinter:contract:top-level-acyclic]
name = Top-level application packages are acyclic
type = acyclic_siblings
ancestors =
    app
depth = 0

[importlinter:contract:framework-middleware-does-not-depend-on-runtime]
name = Framework middleware does not depend on Agent Runtime
type = forbidden
source_modules =
    app.agent.framework_middleware
forbidden_modules =
    app.agent.runtime

[importlinter:contract:foundation-does-not-depend-on-application]
name = Foundation modules do not depend on application modules
type = forbidden
source_modules =
    app.config
    app.contracts
    app.common
forbidden_modules =
    app.api
    app.services
    app.agent
    app.tools
    app.rag
    app.llm
    app.storage
    app.observability
    app.ingestion
    app.sources
    app.indexing

[importlinter:contract:ingestion-domain-is-independent]
name = Knowledge ingestion domain does not depend on runtime adapters
type = forbidden
source_modules =
    app.ingestion
forbidden_modules =
    app.api
    app.services
    app.agent
    app.tools
    app.rag
    app.llm
    app.storage
    app.observability
    app.sources
    app.indexing

[importlinter:contract:http-framework-only-in-api]
name = FastAPI and Starlette are HTTP adapter dependencies
type = forbidden
source_modules =
    app.services
    app.agent
    app.tools
    app.rag
    app.llm
    app.storage
    app.observability
    app.ingestion
    app.sources
    app.indexing
    app.contracts
    app.config
    app.common
forbidden_modules =
    fastapi
    starlette

[importlinter:contract:pydantic-settings-only-in-config]
name = pydantic-settings is encapsulated by app.config
type = forbidden
source_modules =
    app.api
    app.services
    app.agent
    app.tools
    app.rag
    app.llm
    app.storage
    app.observability
    app.ingestion
    app.sources
    app.indexing
    app.contracts
    app.common
forbidden_modules =
    pydantic_settings
allow_indirect_imports = True

[importlinter:contract:rag-read-side-independence]
name = rag-read-side-independence
type = forbidden
source_modules =
    app.rag
forbidden_modules =
    app.ingestion
    app.indexing
    app.sources
    app.storage.ingestion

[importlinter:contract:indexing-write-side-independence]
name = indexing-write-side-independence
type = forbidden
source_modules =
    app.indexing
forbidden_modules =
    app.rag
    app.agent
    app.services
    app.tools
    app.sources

[importlinter:contract:sources-do-not-index]
name = sources-do-not-index
type = forbidden
source_modules =
    app.sources
forbidden_modules =
    app.rag
    app.indexing

[importlinter:contract:agent-no-ingestion-side-effects]
name = agent-no-ingestion-side-effects
type = forbidden
source_modules =
    app.agent
forbidden_modules =
    app.ingestion
    app.indexing
    app.sources

[importlinter:contract:chat-storage-is-independent]
name = chat-storage-is-independent
type = forbidden
source_modules =
    app.storage.memory
forbidden_modules =
    app.ingestion
    app.storage.ingestion
