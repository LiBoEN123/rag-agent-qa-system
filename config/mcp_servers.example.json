{
  "version": 1,
  "servers": {
    "github": {
      "enabled": false,
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "allowed_tools": [
        "get_file_contents"
      ],
      "headers_env": {
        "Authorization": "MCP_GITHUB_AUTHORIZATION",
        "X-MCP-Tools": "MCP_GITHUB_TOOLS",
        "X-MCP-Readonly": "MCP_GITHUB_READONLY"
      }
    },
    "firecrawl": {
      "enabled": false,
      "transport": "http",
      "url": "https://firecrawl.example.com/mcp",
      "allowed_tools": [
        "firecrawl_scrape"
      ],
      "headers_env": {
        "Authorization": "MCP_FIRECRAWL_AUTHORIZATION"
      }
    }
  }
}
