RAG_FILE_PATH=./data/kb
INDEX_STORE_DIR=./data/manifest
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=mini_rag_chunks
# true 时应用启动会强制重建知识库索引
AUTO_REBUILD_ON_STARTUP=false

TOP_K=5
DECOMPOSE_TOP_K=10
CHUNK_OVERLAP=120
CHUNK_SIZE=600

EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
MODEL_CACHE_DIR=./.cache/huggingface/hub

MAX_CONTEXT_CHARS=4000

# =========================
# 请求控制
# =========================

# 单次模型请求最多等 60 秒
LLM_TIMEOUT=60
# 失败后最多重试两次
LLM_MAX_RETRIES=2

# =========================
# Tool Runtime
# =========================
# 进程内共享工具线程池的最大工作线程数
TOOL_RUNTIME_MAX_WORKERS=8
# 明确可重试错误的指数退避基础/上限（毫秒）
TOOL_RETRY_BASE_DELAY_MS=100
TOOL_RETRY_MAX_DELAY_MS=2000
# 退避抖动比例，取值范围 0 到 1
TOOL_RETRY_JITTER_RATIO=0.2

# =========================
# Web Trusted Proxy（仅受控本地开发）
# =========================
# 默认 false：保留各 Web 工具原有代理配置和 requests-hardened SSRF 防护。
# true：WEB_TRUSTED_PROXY_URL 统一覆盖搜索/下载代理，并把 DNS/IP 网络策略委托给代理。
# 受信代理必须自行拒绝私网、环回、metadata 地址和危险重定向。
WEB_TRUSTED_PROXY_MODE=false
WEB_TRUSTED_PROXY_URL=

# =========================
# Web Search (DDGS)
# =========================
# Web Search 会把 query 发送到外部搜索服务；结果可能受限流和网络条件影响。
WEB_SEARCH_REGION=us-en
# 可选值：on、moderate、off；默认使用 moderate。
WEB_SEARCH_SAFESEARCH=moderate
# DDGS 内部 HTTP 超时，必须小于或等于 web_search 的 Runtime 总体超时。
WEB_SEARCH_TIMEOUT=8
# 安全默认模式下的独立代理；受信代理模式开启时会被统一代理覆盖。
WEB_SEARCH_PROXY=

# =========================
# Web Fetch / Web PDF Fetch (requests-hardened + Trafilatura / pypdf)
# =========================
# Web Fetch 会访问 URL 指向的外部网站；URL 和返回正文都属于不可信输入。
WEB_FETCH_CONNECT_TIMEOUT=3
WEB_FETCH_READ_TIMEOUT=10
# 解压后的响应正文上限，防止超大页面和压缩炸弹。
WEB_FETCH_MAX_RESPONSE_BYTES=2000000
WEB_FETCH_MAX_REDIRECTS=5
WEB_FETCH_USER_AGENT=rag-agent-qa-system/1.0
# 安全默认模式下的独立代理；受信代理模式开启时会被统一代理覆盖。
WEB_FETCH_PROXY=
# PDF 使用独立下载字节、文档页数和总体 Runtime 上限，但复用以上网络配置。
WEB_PDF_MAX_RESPONSE_BYTES=10000000
WEB_PDF_MAX_DOCUMENT_PAGES=1000
WEB_PDF_TOOL_TIMEOUT_SECONDS=45

# =========================
# Tool Governance
# =========================
# 当前无用户认证入口使用的最小服务主体；仅授予知识库读取权限。
# 默认不向模型暴露 Web 工具。要启用完整搜索和正文读取，必须显式改为：
# TOOL_DEFAULT_PERMISSIONS=knowledge_base:read,web:search,web:fetch
TOOL_DEFAULT_PRINCIPAL_ID=chat_api
TOOL_DEFAULT_PERMISSIONS=knowledge_base:read
# 独立结构化工具审计日志及脱敏/截断上限
TOOL_AUDIT_ENABLED=true
TOOL_AUDIT_PATH=logs/tool_audit.jsonl
TOOL_AUDIT_MAX_DEPTH=6
TOOL_AUDIT_MAX_ITEMS=20
TOOL_AUDIT_MAX_STRING_CHARS=500
TOOL_AUDIT_MAX_SERIALIZED_CHARS=5000

# =========================
# 模型相关参数
# =========================
LLM_API_KEY=your-api
MODEL_NAME=deepseek-chat
LLM_API_URL=https://api.deepseek.com/v1/chat/completions

# =========================
# RAG 评估 LLM Judge
# =========================
# 开启后，评估脚本会用 JUDGE_MODEL 做逐关键点语义判断，再由程序计算分数。
USE_LLM_JUDGE=false
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_API_URL=https://api.deepseek.com/v1/chat/completions
JUDGE_TIMEOUT=60
JUDGE_MAX_RETRIES=1
JUDGE_MAX_TOKENS=2048

# =========================
# Agent Runtime
# =========================
# LangGraph is the only Agent runtime.
# Agent 单次请求最多执行多少个计划步骤
AGENT_MAX_STEPS=5
# 迭代式 Agent 最多调用模型的轮次
AGENT_MAX_ITERATIONS=6
# 迭代式 Agent 最多实际执行的工具调用总数
AGENT_MAX_TOOL_CALLS=10
# Stop after the third cumulative tool failure.
AGENT_MAX_TOOL_ERRORS=3
# Allow at most two consecutive identical calls; block the third before dispatch.
AGENT_MAX_CONSECUTIVE_SAME_TOOL_CALLS=2
# Stop when the same call fails with the same code for the second consecutive time.
AGENT_MAX_CONSECUTIVE_SAME_TOOL_ERRORS=2
# Cooperative Agent model/tool elapsed-time budget in milliseconds.
AGENT_MAX_TOTAL_COST_MS=120000

# LangGraph checkpoint mode: disabled (default), memory or sqlite
LANGGRAPH_CHECKPOINTER=disabled
# Used only when LANGGRAPH_CHECKPOINTER=sqlite
LANGGRAPH_CHECKPOINT_DB_PATH=./data/langgraph_checkpoints.sqlite3

# =========================
# SQLite persistence
# =========================
# true 时 Agent 会把 agent_runs 和 agent_steps 写入 SQLite；false 时不写入
ENABLE_AGENT_TRACE_STORE=false
# SQLite 数据库路径，默认 ./data/app.sqlite
SQLITE_DB_PATH=./data/app.sqlite

# =========================
# 多轮追问改写模型
# =========================
# true 时 /chat 会在同一 session_id 下对短追问做轻量改写，再进入 Router / RAG。
# API_KEY / MODEL_NAME / API_URL 留空时，代码会回退使用 LLM_API_KEY / MODEL_NAME / LLM_API_URL。
ENABLE_QUERY_REWRITE=true
QUERY_REWRITE_API_KEY=
QUERY_REWRITE_MODEL_NAME=deepseek-chat
QUERY_REWRITE_API_URL=https://api.deepseek.com/v1/chat/completions
QUERY_REWRITE_TIMEOUT=10
QUERY_REWRITE_MAX_TOKENS=256
QUERY_REWRITE_TEMPERATURE=0.0

# =========================
# 问题拆分模型
# =========================
DECOMPOSE_API_KEY=your-api
DECOMPOSE_MODEL_NAME=qwen-plus
DECOMPOSE_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
ENABLE_QUERY_DECOMPOSE=true
DECOMPOSE_TIMEOUT=15
DECOMPOSE_MAX_TOKENS=512

TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# =========================
# 召回chunk的拒绝阈值
# =========================
VECTOR_THRESHOLD=0.1
